      "role": "agent",
      "start_time": 8.7,
      "end_time": 21.41,
      "duration": 12.71,
      "transcript": "I'm sorry you're getting stuck. Let's get you set up. Are you using the mobile app or a web browser, and what step are you on when it fails (e.g., receiving the code, scanning the QR code, or entering the backup code)?",
      "transcript_truncated": true
