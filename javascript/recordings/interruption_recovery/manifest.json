      "role": "user",
      "start_time": 21.41,
      "end_time": 25.06,
      "duration": 3.6499999999999986,
      "transcript": "Actually — hold on, can you just reset my password instead?"
    },
    {
      "idx": 4,
      "file": "segments/04-agent-25060ms.wav",
      "role": "agent",
      "start_time": 25.06,
      "end_time": 31.169999999999998,
      "duration": 6.109999999999999,
      "transcript": "Absolutely, happy to walk you through it. Are you turning it on in the mobile app or on the website?"
    },
    {
      "idx": 5,
      "file": "segments/05-user-31169ms.wav",
      "role": "user",
      "start_time": 31.169999999999998,
      "end_time": 34.17,
      "duration": 3.0000000000000036,
      "transcript": "Perfect. How long does the reset email take?"
    },
    {
      "idx": 6,
      "file": "segments/06-agent-34170ms.wav",
      "role": "agent",
      "start_time": 34.17,
      "end_time": 39.67,
      "duration": 5.5,
      "transcript": "Of course, I can help with a password reset. What's the email or username on your account?",
      "transcript_truncated": true
