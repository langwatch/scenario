{
  "name": "scenario-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf docs/dist",
    "generate:mdx-examples": "node scripts/generate-mdx-examples.js",
    "dev": "pnpm generate:mdx-examples && vocs dev",
    "build": "pnpm generate:mdx-examples && vocs build",
    "preview": "vocs preview",
    "build:preview": "pnpm build && vocs preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.35.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "vocs": "github:langwatch/vocs#build",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "latest",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-mdx": "^3.6.2",
    "eslint-plugin-mdx": "^3.6.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "jiti": "^2.6.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
